rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: apakah uid ini anggota household (households/{householdOwnerUid})?
    function isHouseholdMember(householdOwnerUid) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/households/$(householdOwnerUid)) &&
             request.auth.uid in
               get(/databases/$(database)/documents/households/$(householdOwnerUid)).data.memberUids;
    }

    // households/{householdOwnerUid}: dokumen ID = uid pembuat pertama.
    // - Siapa pun anggotanya (memberUids) boleh baca.
    // - Hanya pembuatnya sendiri yang boleh membuat dokumen ini (bootstrap).
    // - Update diperbolehkan oleh anggota yang sudah ada (mis. menambah
    //   memberEmails saat mengundang) ATAU oleh uid baru yang menambahkan
    //   dirinya sendiri ke memberUids (proses klaim undangan).
    //   CATATAN KEAMANAN: model ini memverifikasi kecocokan email di sisi
    //   klien (claimInvitation mencari household yang memuat email user)
    //   sebelum menulis; rule ini tidak bisa memvalidasi ulang kecocokan
    //   email secara atomic tanpa Cloud Functions. Untuk aplikasi keluarga
    //   pribadi ini dianggap risiko yang wajar; jangan bagikan project
    //   Firebase ini ke pihak tak dikenal.
    match /households/{ownerUid} {
      allow read: if request.auth != null &&
                    (resource == null || request.auth.uid in resource.data.memberUids);
      allow create: if request.auth != null && request.auth.uid == ownerUid;
      allow update: if request.auth != null && (
                      request.auth.uid in resource.data.memberUids ||
                      request.auth.uid in request.resource.data.memberUids
                    );
    }

    // users/{uid}: pointer kecil "uid ini sedang aktif di household siapa".
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Profil dokter dibagikan ke seluruh anggota household.
    match /doctors/{doctorId} {
      allow read, update: if isHouseholdMember(resource.data.ownerUid);
      allow create: if isHouseholdMember(request.resource.data.ownerUid);
    }

    // Profil anggota keluarga: seluruh anggota household boleh baca/tulis.
    match /familyMembers/{memberId} {
      allow read, update, delete: if isHouseholdMember(resource.data.ownerUid);
      allow create: if isHouseholdMember(request.resource.data.ownerUid);
    }

    // Seluruh catatan kesehatan (sickness, lab, lifestyle, dst) berada di
    // subcollection per memberId. Akses divalidasi lewat ownerUid (household)
    // milik dokumen familyMembers yang bersangkutan.
    match /healthRecords/{memberId}/{collection}/{docId} {
      allow read, write: if isHouseholdMember(
        get(/databases/$(database)/documents/familyMembers/$(memberId)).data.ownerUid
      );
    }

    // Tolak semua akses lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
