rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profil anggota keluarga: hanya pemilik akun (ownerUid) yang boleh
    // membaca/menulis, baik saat membuat maupun mengubah dokumen.
    match /familyMembers/{memberId} {
      allow read, update, delete: if request.auth != null
                                    && request.auth.uid == resource.data.ownerUid;
      allow create: if request.auth != null
                     && request.auth.uid == request.resource.data.ownerUid;
    }

    // Seluruh catatan kesehatan (sickness, lab, lifestyle, dst) berada di
    // subcollection per memberId. Akses divalidasi dengan mencocokkan
    // ownerUid milik dokumen familyMembers yang bersangkutan.
    match /healthRecords/{memberId}/{collection}/{docId} {
      allow read, write: if request.auth != null
                           && request.auth.uid ==
                              get(/databases/$(database)/documents/familyMembers/$(memberId)).data.ownerUid;
    }

    // Tolak semua akses lain secara default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
