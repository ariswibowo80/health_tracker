# Salin file ini menjadi ".env" lalu isi dengan kredensial project Firebase Anda
# (Project Settings -> General -> Your apps -> SDK setup and configuration).
# JANGAN commit file ".env" yang sudah terisi ke Git.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Diperlukan HANYA untuk tombol "Masuk dengan Google" di Android/iOS.
# Ambil dari Google Cloud Console > APIs & Services > Credentials
# (dibuat otomatis saat mengaktifkan provider Google di Firebase Authentication).
# Web tidak butuh variabel ini (pakai popup bawaan Firebase).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
